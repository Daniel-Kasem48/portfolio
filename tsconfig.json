{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "--yarn",
    "src/main.tsx",
    "src/routes.tsx",
    "src/pages/**/*",
    "src/components/AiChat.tsx",
    "src/components/Skills.tsx",
    "src/components/SkillsMap.tsx",
    "src/components/TestSkills.tsx",
    "src/layouts/MainLayout.tsx",
    "src/layouts/index.ts",
    "src/layouts/LoaderLayout.tsx",
    "vite.config.ts"
  ]
}
